# syntax=docker/dockerfile:1.7
# Builds flash-attn from source against torch 2.14.0+cu130 / Python 3.12 / sm_89 (RTX 4090)
# Final stage is a scratch image containing ONLY the built wheel.

FROM pytorch/pytorch:2.14.0-cuda13.0-cudnn9-devel AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    FLASH_ATTN_CUDA_ARCHS="80;90;100;120" \
    MAX_JOBS=1 \
    FLASH_ATTENTION_VERSION=2.8.3.post1

RUN apt-get update && apt-get install -y --no-install-recommends python3.12-venv git \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv --system-site-packages /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

RUN pip install --no-cache-dir packaging ninja wheel

RUN git clone --depth 1 --recursive --shallow-submodules \
        --branch "v${FLASH_ATTENTION_VERSION}" \
        https://github.com/Dao-AILab/flash-attention.git /build

WORKDIR /build
# torch 2.14 headers require C++20 (std::strong_ordering); flash-attn hardcodes C++17
RUN sed -i 's/-std=c++17/-std=c++20/g' setup.py
RUN python setup.py bdist_wheel

FROM scratch
COPY --from=builder /build/dist/*.whl /wheels/
